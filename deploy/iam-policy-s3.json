{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListingSpecificBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::hris-company-storage"]
    },
    {
      "Sid": "AllowAllObjectActionsInSpecificBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::hris-company-storage/*"]
    }
  ]
}

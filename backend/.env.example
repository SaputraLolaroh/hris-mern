# === Server ===
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# === Database (lokal / Amazon RDS) ===
DATABASE_URL=postgres://postgres:password@localhost:5432/hris_db
# Atau pisah (jika DATABASE_URL kosong, gunakan DB_* di bawah):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=hris_db

# === JWT ===
# WAJIB ganti dengan string acak minimal 32 karakter di produksi!
JWT_SECRET=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter
JWT_EXPIRES_IN=2h

# === Validasi GPS Absensi ===
OFFICE_LAT=-6.2088
OFFICE_LON=106.8456
MAX_RADIUS_METERS=100

# === AWS S3 (kosongkan key jika memakai IAM Role di EC2) ===
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=hris-company-storage
# AWS_ACCESS_KEY_ID=          <-- opsional, hanya untuk lokal
# AWS_SECRET_ACCESS_KEY=      <-- opsional, hanya untuk lokal
